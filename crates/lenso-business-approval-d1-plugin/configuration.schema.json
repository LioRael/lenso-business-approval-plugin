{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lenso Business Approval D1 Plugin configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requester_instances",
    "decider_instances",
    "expiration_executor_instances"
  ],
  "properties": {
    "requester_instances": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "decider_instances": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "expiration_executor_instances": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  }
}
