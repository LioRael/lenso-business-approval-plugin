{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "decision", "decided_by", "evidence_ref", "reason"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"},
    "decision": {"type": "string", "enum": ["approved", "rejected"]},
    "decided_by": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9._:/-]+$"},
    "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9._:/-]+$"},
    "reason": {"type": ["string", "null"], "maxLength": 1000}
  }
}
